network:
  version: 2
  ethernets:
    {{ bastion_home_iface }}:
      dhcp4: false
      addresses: [{{ bastion_home_address }}]
      routes:
        - to: default
          via: {{ bastion_home_gateway }}
      nameservers:
        addresses: {{ bastion_home_dns }}
        search: [lab.local]
    {{ bastion_lab_iface }}:
      dhcp4: false
      addresses: [{{ bastion_lab_address }}]
      nameservers:
        search: [lab.local]
